# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Database URL (for automated migrations - optional)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Coinbase Commerce (Crypto Payments)
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_webhook_secret_optional

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Development (optional)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Age Verification Provider (optional)
AGE_VERIFICATION_PROVIDER=dob-photo
